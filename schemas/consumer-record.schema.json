{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kaskade/main/schemas/consumer-record.schema.json",
  "title": "Kaskade Consumer Record",
  "description": "The versionless JSON contract shared by record details, clipboard copies, and exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "partition",
    "offset",
    "timestamp",
    "headers",
    "key",
    "value"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "partition": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/header"
      }
    },
    "key": {
      "$ref": "#/$defs/deserializedField"
    },
    "value": {
      "$ref": "#/$defs/deserializedField"
    }
  },
  "$defs": {
    "deserializerType": {
      "enum": [
        "BYTES",
        "BOOLEAN",
        "STRING",
        "LONG",
        "INTEGER",
        "DOUBLE",
        "FLOAT",
        "JSON",
        "AVRO",
        "PROTOBUF",
        "REGISTRY"
      ]
    },
    "nonBytesDeserializerType": {
      "enum": [
        "BOOLEAN",
        "STRING",
        "LONG",
        "INTEGER",
        "DOUBLE",
        "FLOAT",
        "JSON",
        "AVRO",
        "PROTOBUF"
      ]
    },
    "bytesEncoding": {
      "enum": [
        "BASE64",
        "HEX",
        "BYTE_ARRAY",
        "ESCAPED"
      ]
    },
    "base64Content": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "hexContent": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "byteArrayContent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "escapedContent": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x5b\\x5d-\\x7e]|\\\\\\\\|\\\\x[0-9a-f]{2})*$"
    },
    "encodedBytes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/byteArrayContent"
        }
      ]
    },
    "schemaMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "version",
        "type"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "AVRO",
            "JSON"
          ]
        }
      }
    },
    "bytesDeserializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "encoding"
      ],
      "properties": {
        "type": {
          "const": "BYTES"
        },
        "encoding": {
          "$ref": "#/$defs/bytesEncoding"
        }
      }
    },
    "errorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "fallback"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "fallback": {
          "$ref": "#/$defs/bytesDeserializer"
        }
      }
    },
    "nullDeserializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/deserializerType"
        }
      }
    },
    "nonBytesDeserializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/nonBytesDeserializerType"
        }
      }
    },
    "registryDeserializer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "REGISTRY"
        },
        "schema": {
          "$ref": "#/$defs/schemaMetadata"
        }
      }
    },
    "deserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer"
      ],
      "properties": {
        "content": {},
        "deserializer": {},
        "error": {
          "$ref": "#/$defs/errorMetadata"
        }
      },
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "content": {
              "type": "null"
            },
            "deserializer": {
              "$ref": "#/$defs/nullDeserializer"
            }
          }
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "content": {
              "$ref": "#/$defs/encodedBytes"
            },
            "deserializer": {
              "$ref": "#/$defs/bytesDeserializer"
            }
          }
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "content": {
              "not": {
                "type": "null"
              }
            },
            "deserializer": {
              "$ref": "#/$defs/nonBytesDeserializer"
            }
          }
        },
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "content": {
              "not": {
                "type": "null"
              }
            },
            "deserializer": {
              "$ref": "#/$defs/registryDeserializer"
            }
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "content": {
              "$ref": "#/$defs/encodedBytes"
            },
            "deserializer": {
              "$ref": "#/$defs/nullDeserializer"
            },
            "error": {
              "$ref": "#/$defs/errorMetadata"
            }
          }
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/successfulBytesEncodingRules"
        },
        {
          "$ref": "#/$defs/errorBytesEncodingRules"
        }
      ]
    },
    "successfulBytesEncodingRules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "deserializer": {
                "required": [
                  "type",
                  "encoding"
                ],
                "properties": {
                  "type": {
                    "const": "BYTES"
                  },
                  "encoding": {
                    "const": "BASE64"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/base64Content"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deserializer": {
                "required": [
                  "type",
                  "encoding"
                ],
                "properties": {
                  "type": {
                    "const": "BYTES"
                  },
                  "encoding": {
                    "const": "HEX"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/hexContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deserializer": {
                "required": [
                  "type",
                  "encoding"
                ],
                "properties": {
                  "type": {
                    "const": "BYTES"
                  },
                  "encoding": {
                    "const": "BYTE_ARRAY"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/byteArrayContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "deserializer": {
                "required": [
                  "type",
                  "encoding"
                ],
                "properties": {
                  "type": {
                    "const": "BYTES"
                  },
                  "encoding": {
                    "const": "ESCAPED"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/escapedContent"
              }
            }
          }
        }
      ]
    },
    "errorBytesEncodingRules": {
      "allOf": [
        {
          "$ref": "#/$defs/errorBase64Rule"
        },
        {
          "$ref": "#/$defs/errorHexRule"
        },
        {
          "$ref": "#/$defs/errorByteArrayRule"
        },
        {
          "$ref": "#/$defs/errorEscapedRule"
        }
      ]
    },
    "errorBase64Rule": {
      "if": {
        "$ref": "#/$defs/errorEncodingBase64Condition"
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/base64Content"
          }
        }
      }
    },
    "errorHexRule": {
      "if": {
        "$ref": "#/$defs/errorEncodingHexCondition"
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/hexContent"
          }
        }
      }
    },
    "errorByteArrayRule": {
      "if": {
        "$ref": "#/$defs/errorEncodingByteArrayCondition"
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/byteArrayContent"
          }
        }
      }
    },
    "errorEscapedRule": {
      "if": {
        "$ref": "#/$defs/errorEncodingEscapedCondition"
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/escapedContent"
          }
        }
      }
    },
    "errorEncodingBase64Condition": {
      "$ref": "#/$defs/errorEncodingConditionBase",
      "properties": {
        "error": {
          "properties": {
            "fallback": {
              "properties": {
                "encoding": {
                  "const": "BASE64"
                }
              }
            }
          }
        }
      }
    },
    "errorEncodingHexCondition": {
      "$ref": "#/$defs/errorEncodingConditionBase",
      "properties": {
        "error": {
          "properties": {
            "fallback": {
              "properties": {
                "encoding": {
                  "const": "HEX"
                }
              }
            }
          }
        }
      }
    },
    "errorEncodingByteArrayCondition": {
      "$ref": "#/$defs/errorEncodingConditionBase",
      "properties": {
        "error": {
          "properties": {
            "fallback": {
              "properties": {
                "encoding": {
                  "const": "BYTE_ARRAY"
                }
              }
            }
          }
        }
      }
    },
    "errorEncodingEscapedCondition": {
      "$ref": "#/$defs/errorEncodingConditionBase",
      "properties": {
        "error": {
          "properties": {
            "fallback": {
              "properties": {
                "encoding": {
                  "const": "ESCAPED"
                }
              }
            }
          }
        }
      }
    },
    "errorEncodingConditionBase": {
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "required": [
            "fallback"
          ],
          "properties": {
            "fallback": {
              "required": [
                "encoding"
              ]
            }
          }
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {},
        "error": {
          "$ref": "#/$defs/errorMetadata"
        }
      },
      "oneOf": [
        {
          "not": {
            "required": [
              "error"
            ]
          },
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "required": [
            "error"
          ],
          "properties": {
            "value": {
              "$ref": "#/$defs/encodedBytes"
            },
            "error": {
              "$ref": "#/$defs/errorMetadata"
            }
          }
        }
      ],
      "allOf": [
        {
          "$ref": "#/$defs/headerErrorBytesEncodingRules"
        }
      ]
    },
    "headerErrorBytesEncodingRules": {
      "allOf": [
        {
          "if": {
            "$ref": "#/$defs/errorEncodingBase64Condition"
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/base64Content"
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/errorEncodingHexCondition"
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/hexContent"
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/errorEncodingByteArrayCondition"
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/byteArrayContent"
              }
            }
          }
        },
        {
          "if": {
            "$ref": "#/$defs/errorEncodingEscapedCondition"
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/escapedContent"
              }
            }
          }
        }
      ]
    }
  }
}
