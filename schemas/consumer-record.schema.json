{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/sauljabin/kaskade/main/schemas/consumer-record.schema.json",
  "title": "Kaskade Consumer Record",
  "description": "The versionless JSON contract shared by record details, clipboard copies, and exports.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "partition",
    "offset",
    "timestamp",
    "headers",
    "key",
    "value"
  ],
  "properties": {
    "topic": {
      "type": "string"
    },
    "partition": {
      "type": "integer",
      "minimum": 0
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        {
          "type": "null"
        }
      ]
    },
    "headers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/header"
      }
    },
    "key": {
      "$ref": "#/$defs/deserializedField"
    },
    "value": {
      "$ref": "#/$defs/deserializedField"
    }
  },
  "$defs": {
    "deserializerType": {
      "enum": [
        "BYTES",
        "BOOLEAN",
        "STRING",
        "LONG",
        "INTEGER",
        "DOUBLE",
        "FLOAT",
        "JSON",
        "AVRO",
        "PROTOBUF",
        "REGISTRY"
      ]
    },
    "nonBytesDeserializerType": {
      "enum": [
        "BOOLEAN",
        "STRING",
        "LONG",
        "INTEGER",
        "DOUBLE",
        "FLOAT",
        "JSON",
        "AVRO",
        "PROTOBUF"
      ]
    },
    "bytesEncoding": {
      "enum": [
        "BASE64",
        "HEX",
        "BYTE_ARRAY",
        "ESCAPED"
      ]
    },
    "base64Content": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "hexContent": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$"
    },
    "byteArrayContent": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      }
    },
    "escapedContent": {
      "type": "string",
      "pattern": "^(?:[\\x20-\\x5b\\x5d-\\x7e]|\\\\\\\\|\\\\x[0-9a-f]{2})*$"
    },
    "encodedBytes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/byteArrayContent"
        }
      ]
    },
    "schemaMetadata": {
      "oneOf": [
        {
          "$ref": "#/$defs/confluentSchemaMetadata"
        },
        {
          "$ref": "#/$defs/apicurioSchemaMetadata"
        }
      ]
    },
    "confluentSchemaMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "subject",
        "version",
        "type"
      ],
      "properties": {
        "provider": {
          "const": "CONFLUENT"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "AVRO",
            "JSON",
            "PROTOBUF"
          ]
        }
      }
    },
    "apicurioSchemaMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "id",
        "id_kind",
        "type"
      ],
      "properties": {
        "provider": {
          "const": "APICURIO"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "id_kind": {
          "enum": [
            "CONTENT_ID",
            "GLOBAL_ID"
          ]
        },
        "group": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "AVRO",
            "JSON",
            "PROTOBUF"
          ]
        }
      }
    },
    "errorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "fallback",
        "encoding"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "fallback": {
          "const": "BYTES"
        },
        "encoding": {
          "$ref": "#/$defs/bytesEncoding"
        }
      }
    },
    "deserializedField": {
      "oneOf": [
        {
          "$ref": "#/$defs/nullDeserializedField"
        },
        {
          "$ref": "#/$defs/bytesDeserializedField"
        },
        {
          "$ref": "#/$defs/nonBytesDeserializedField"
        },
        {
          "$ref": "#/$defs/registryDeserializedField"
        },
        {
          "$ref": "#/$defs/errorDeserializedField"
        }
      ]
    },
    "nullDeserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer"
      ],
      "properties": {
        "content": {
          "type": "null"
        },
        "deserializer": {
          "$ref": "#/$defs/deserializerType"
        }
      }
    },
    "bytesDeserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer",
        "encoding"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/encodedBytes"
        },
        "deserializer": {
          "const": "BYTES"
        },
        "encoding": {
          "$ref": "#/$defs/bytesEncoding"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/fieldEncodingRules"
        }
      ]
    },
    "nonBytesDeserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer"
      ],
      "properties": {
        "content": {
          "not": {
            "type": "null"
          }
        },
        "deserializer": {
          "$ref": "#/$defs/nonBytesDeserializerType"
        }
      }
    },
    "registryDeserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer"
      ],
      "properties": {
        "content": {
          "not": {
            "type": "null"
          }
        },
        "deserializer": {
          "const": "REGISTRY"
        },
        "schema": {
          "$ref": "#/$defs/schemaMetadata"
        }
      }
    },
    "errorDeserializedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content",
        "deserializer",
        "error"
      ],
      "properties": {
        "content": {
          "$ref": "#/$defs/encodedBytes"
        },
        "deserializer": {
          "$ref": "#/$defs/deserializerType"
        },
        "error": {
          "$ref": "#/$defs/errorMetadata"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/errorEncodingRules"
        }
      ]
    },
    "fieldEncodingRules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "BASE64"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/base64Content"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "HEX"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/hexContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "BYTE_ARRAY"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/byteArrayContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "encoding": {
                "const": "ESCAPED"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/escapedContent"
              }
            }
          }
        }
      ]
    },
    "errorEncodingRules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "BASE64"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/base64Content"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "HEX"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/hexContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "BYTE_ARRAY"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/byteArrayContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "ESCAPED"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "$ref": "#/$defs/escapedContent"
              }
            }
          }
        }
      ]
    },
    "header": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "key",
            "value"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/errorHeader"
        }
      ]
    },
    "errorHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value",
        "error"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/encodedBytes"
        },
        "error": {
          "$ref": "#/$defs/errorMetadata"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/headerErrorEncodingRules"
        }
      ]
    },
    "headerErrorEncodingRules": {
      "allOf": [
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "BASE64"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/base64Content"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "HEX"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/hexContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "BYTE_ARRAY"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/byteArrayContent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "error": {
                "properties": {
                  "encoding": {
                    "const": "ESCAPED"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/escapedContent"
              }
            }
          }
        }
      ]
    }
  }
}
